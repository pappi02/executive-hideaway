# --- Database (Supabase Postgres) -------------------------------------------
# Supabase dashboard -> Connect -> "ORMs" / "Connection string".
#
# App connection: the TRANSACTION pooler (port 6543). src/lib/prisma.ts turns
# connection_limit / connect_timeout / pool_timeout into node-postgres pool
# options (connection_limit=1: one connection per serverless function).
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# Migration connection: the SESSION pooler (or direct connection), port 5432.
# Used by `npm run db:deploy` / `db:migrate`, the seed and image scripts, and `next build`.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Optional: Supabase's CA certificate (PEM; Supabase dashboard -> Database ->
# SSL Configuration). With it, the app verifies the database server's
# certificate; without it the connection is still encrypted but unverified.
# Line breaks may be written as a literal backslash-n.
DATABASE_CA_CERT=

# --- Room photo storage (Vercel Blob) ----------------------------------------
# Added automatically when a Blob store is connected to the Vercel project;
# `vercel env pull .env.local` brings it down for local dev. Without it, uploads
# fall back to storing image bytes in the database.
BLOB_READ_WRITE_TOKEN=

# --- Auth ---------------------------------------------------------------------
# Used by NextAuth to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Only needed once, to seed the first admin login (npm run db:seed).
# Safe to remove from .env.local after the first successful seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Site URL -------------------------------------------------------------------
# Canonical origin used for metadata, sitemap.xml, robots.txt and JSON-LD.
# Leave unset on Vercel to use the project's production domain automatically;
# set it once a custom domain (e.g. https://executivehideaway.co.ke) is live.
NEXT_PUBLIC_SITE_URL=
