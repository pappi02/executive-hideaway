generator client {
  // Prisma 7's TypeScript client: generated into the source tree (gitignored,
  // rebuilt by `prisma generate` on install) and talks to Postgres through the
  // node-postgres driver adapter — no Rust query engine binary to bundle.
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Connection URLs live in prisma.config.ts (CLI) and src/lib/prisma.ts (app).
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model ServiceCategory {
  id          String    @id // "haircut", "massage", etc.
  label       String
  eyebrow     String
  description String
  image       String
  imageAlt    String
  order       Int       @default(0)
  services    Service[]
}

model Service {
  id          String          @id
  name        String
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  description String
  price       Int?
  duration    Int
  image       String
  imageAlt    String
  order       Int             @default(0)

  @@index([categoryId])
}

model Accommodation {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  description       String
  pricePerNight     Int?
  priceIsIndicative Boolean              @default(true)
  isTemporary       Boolean              @default(false)
  numberOfRooms     Int                  @default(1)
  maxGuests         Int                  @default(1)
  bedType           String?
  roomSize          String?
  bathroom          String?
  amenities         String[]             @default([])
  breakfastIncluded Boolean?
  wifiAvailable     Boolean?
  parkingAvailable  Boolean?
  childrenAllowed   Boolean              @default(false)
  featured          Boolean              @default(false)
  active            Boolean              @default(true)
  order             Int                  @default(0)
  images            AccommodationImage[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([active, order])
}

model AccommodationImage {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  // Vercel Blob URL. New uploads store the image there and leave `data` null.
  url             String?
  // Legacy: raw image bytes. Only set on rows not yet moved by `npm run images:migrate`.
  data            Bytes?        @db.ByteA
  contentType     String
  altText         String
  order           Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([accommodationId, order])
}

model ResortFacility {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  category    String
  description String?
  href        String?
  active      Boolean @default(true)
  order       Int     @default(0)
}

model AccommodationSettings {
  id        String   @id @default("default")
  checkIn   String?
  checkOut  String?
  updatedAt DateTime @updatedAt
}

model Chapter {
  id            String    @id
  eyebrow       String
  title         String
  standfirst    String?
  image         String?
  imagePosition String?
  note          String?
  footnote      String?
  columns       Int       @default(1) // 1 | 2
  stock         String    @default("onyx") // "onyx" | "bone"
  order         Int       @default(0)
  published     Boolean   @default(true) // false: admin preview only
  sections      Section[]
}

model Section {
  id        String  @id
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])
  title     String
  note      String?
  order     Int     @default(0)
  dishes    Dish[]

  @@index([chapterId])
}

model Dish {
  id          String  @id
  sectionId   String
  section     Section @relation(fields: [sectionId], references: [id])
  name        String
  description String?
  price       Int?
  priceNote   String?
  tags        String[] @default([]) // DishTag[]: vegetarian | vegan | spicy | signature | gluten-free | contains-nuts
  unavailable Boolean  @default(false)
  order       Int      @default(0)

  @@index([sectionId])
}

/// One row per failed admin sign-in, keyed by "email:<address>" and "ip:<address>".
/// Read by src/lib/login-throttle.ts to slow down password guessing; rows older
/// than a day are pruned as new failures come in.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Promotional poster shown as a timed pop-up on the public site (see
/// src/components/layout/PosterPopup.tsx), managed at /admin/posters. Runs
/// from startsAt to endsAt; each device sees it at most once a day.
model Poster {
  id               String   @id @default(cuid())
  title            String
  // A file under /public (e.g. /posters/x.webp) or a Vercel Blob URL.
  imageUrl         String?
  // Fallback when no Blob store is connected: the image bytes themselves,
  // served by /api/posters/[id]/image.
  imageData        Bytes?   @db.ByteA
  imageType        String?
  // Optional: where clicking the poster goes (a site path, https:// or tel:).
  linkUrl          String?
  startsAt         DateTime
  endsAt           DateTime
  // Seconds after landing before it pops up.
  delaySeconds     Int      @default(10)
  // Seconds before it closes itself; 0 = until the visitor closes it.
  autoCloseSeconds Int      @default(6)
  // When several posters run at once, the highest priority shows.
  priority         Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active, endsAt])
}
