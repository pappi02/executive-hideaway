generator client {
  provider      = "prisma-client-js"
  // Without this, Prisma can bundle engine binaries for every platform it
  // thinks it might need into each deployment's function output. "native"
  // keeps local dev working (Windows), "rhel-openssl-3.0.x" is the one
  // Vercel's Node.js serverless runtime actually needs — nothing else.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model ServiceCategory {
  id          String    @id // "haircut", "massage", etc.
  label       String
  eyebrow     String
  description String
  image       String
  imageAlt    String
  order       Int       @default(0)
  services    Service[]
}

model Service {
  id          String          @id
  name        String
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  description String
  price       Int?
  duration    Int
  image       String
  imageAlt    String
  order       Int             @default(0)

  @@index([categoryId])
}

model Accommodation {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  description       String
  pricePerNight     Int?
  priceIsIndicative Boolean              @default(true)
  isTemporary       Boolean              @default(false)
  numberOfRooms     Int                  @default(1)
  maxGuests         Int                  @default(1)
  bedType           String?
  roomSize          String?
  bathroom          String?
  amenities         String[]             @default([])
  breakfastIncluded Boolean?
  wifiAvailable     Boolean?
  parkingAvailable  Boolean?
  childrenAllowed   Boolean              @default(false)
  featured          Boolean              @default(false)
  active            Boolean              @default(true)
  order             Int                  @default(0)
  images            AccommodationImage[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([active, order])
}

model AccommodationImage {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  data            Bytes         @db.ByteA
  contentType     String
  altText         String
  order           Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([accommodationId, order])
}

model ResortFacility {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  category    String
  description String?
  href        String?
  active      Boolean @default(true)
  order       Int     @default(0)
}

model AccommodationSettings {
  id        String   @id @default("default")
  checkIn   String?
  checkOut  String?
  updatedAt DateTime @updatedAt
}

model Chapter {
  id            String    @id
  eyebrow       String
  title         String
  standfirst    String?
  image         String?
  imagePosition String?
  note          String?
  footnote      String?
  columns       Int       @default(1) // 1 | 2
  stock         String    @default("onyx") // "onyx" | "bone"
  order         Int       @default(0)
  sections      Section[]
}

model Section {
  id        String  @id
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])
  title     String
  note      String?
  order     Int     @default(0)
  dishes    Dish[]

  @@index([chapterId])
}

model Dish {
  id          String  @id
  sectionId   String
  section     Section @relation(fields: [sectionId], references: [id])
  name        String
  description String?
  price       Int?
  priceNote   String?
  tags        String[] @default([]) // DishTag[]: vegetarian | vegan | spicy | signature | gluten-free | contains-nuts
  unavailable Boolean  @default(false)
  order       Int      @default(0)

  @@index([sectionId])
}
